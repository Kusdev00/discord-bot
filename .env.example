# Discord Bot Configuration
# Copy this file to .env and fill in your values

# Required: Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Optional: Command prefix for text commands (default: !)
COMMAND_PREFIX=!

# Optional: Bot activity status
# Types: playing, streaming, listening, watching
ACTIVITY_TYPE=playing
ACTIVITY_NAME=with welcome system

# Optional: Test guild ID for faster command syncing during development
# TEST_GUILD_ID=123456789012345678

# Welcome System Configuration
WELCOME_ENABLED=true

# Channel ID where welcome messages will be sent (set via /welcome channel command)
# WELCOME_CHANNEL_ID=1510712073196142702

# Channel ID for testing welcome messages (your private logs channel)
WELCOME_TEST_CHANNEL_ID=1510712073196142702

# Default embed color for welcome messages
# Options: random, #ff6b6b (hex), red, green, blue, yellow, purple, orange, pink, cyan
WELCOME_DEFAULT_COLOR=random

# Logging Configuration
LOG_LEVEL=INFO
# LOG_FILE=logs/bot.log

# Development
DEBUG=false